{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trung-tam-tai-chinh/contracts/conflict_disclosure.schema.json",
  "title": "CONFLICT_DISCLOSURE",
  "description": "Kiểm tra xung đột lợi ích Đầu tư ↔ Truyền thông",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "created_at",
    "story_ref",
    "assets_mentioned",
    "conflict_found"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "story_ref": {
      "type": "string"
    },
    "assets_mentioned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "held_positions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "under_research": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict_found": {
      "type": "boolean"
    },
    "disclosure_text": {
      "type": "string"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
