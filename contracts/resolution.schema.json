{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trung-tam-tai-chinh/contracts/resolution.schema.json",
  "title": "RESOLUTION",
  "description": "Kết quả phân định một dự báo: do code chấm (engine, luật excess_return_positive) hoặc do người đọc nguồn qua Issue Resolution (ADR-0003). VOID = outcome null kèm void (lý do).",
  "type": "object",
  "required": [
    "prediction_id",
    "resolved_at",
    "outcome"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "prediction_id": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date"
    },
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "exit_date": {
      "type": "string",
      "format": "date"
    },
    "excess_return": {
      "type": [
        "number",
        "null"
      ],
      "description": "null khi VOID (engine/ledger.resolve: lỗi dữ liệu giá trong cửa sổ chấm)"
    },
    "outcome": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        0,
        1,
        null
      ]
    },
    "void": {
      "type": "string",
      "minLength": 1,
      "description": "Lý do không phân định được; bắt buộc khi outcome null"
    },
    "resolution_issue": {
      "type": "integer"
    },
    "resolution_issue_created_at": {
      "type": "string"
    },
    "resolver": {
      "type": "string",
      "minLength": 1
    },
    "resolution_source": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "observed_value": {
      "type": "string"
    },
    "prev_hash": {
      "type": "string"
    },
    "hash": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "if": {
    "properties": {
      "outcome": {
        "const": null
      }
    }
  },
  "then": {
    "required": [
      "void"
    ]
  }
}
