{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trung-tam-tai-chinh/contracts/knowledge_item.schema.json",
  "title": "KNOWLEDGE_ITEM",
  "description": "Mục tri thức (candidate hoặc canonical)",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "created_at",
    "statement",
    "status",
    "evidence_refs"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "OBSERVATION",
        "UNVERIFIED",
        "WEAK",
        "SUPPORTED",
        "STRONG",
        "REGIME_SPECIFIC",
        "INVALIDATED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valid_regimes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unverified_regimes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validated_by": {
      "type": "string"
    },
    "validated_at": {
      "type": "string",
      "format": "date-time"
    },
    "invalidation_reason": {
      "type": "string"
    },
    "review_by": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
