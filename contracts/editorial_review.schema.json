{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trung-tam-tai-chinh/contracts/editorial_review.schema.json",
  "title": "EDITORIAL_REVIEW",
  "description": "Duyệt biên tập",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "created_at",
    "story_ref",
    "reviewer",
    "accuracy",
    "balance",
    "decision",
    "legal_policy_check",
    "disclaimer_present",
    "ai_disclosure"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "0.2"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "story_ref": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "accuracy": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "clarity": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "context": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "balance": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "uncertainty_disclosed": {
      "type": "boolean"
    },
    "clickbait_check": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVE",
        "REVISE",
        "REJECT"
      ]
    },
    "notes": {
      "type": "string"
    },
    "legal_policy_check": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ],
      "description": "Đạt governance/MEDIA_LEGAL_POLICY.md: không khuyến nghị (kể cả ngầm), không phân tích mã kèm định giá, không kéo vào nhóm kín/dịch vụ trả phí, không nhắc mã trong danh mục"
    },
    "legal_violations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Câu/đoạn vi phạm và điều cấm tương ứng (1-4)"
    },
    "disclaimer_present": {
      "type": "boolean",
      "description": "Có câu: 'Nội dung chỉ nhằm mục đích thông tin và giáo dục, không phải khuyến nghị đầu tư'"
    },
    "ai_disclosure": {
      "type": "string",
      "enum": [
        "PRESENT",
        "NOT_APPLICABLE",
        "MISSING"
      ],
      "description": "Công bố dùng AI nếu có giọng/người dẫn AI"
    }
  },
  "additionalProperties": false
}