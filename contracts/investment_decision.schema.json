{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trung-tam-tai-chinh/contracts/investment_decision.schema.json",
  "title": "INVESTMENT_DECISION",
  "description": "Gói quyết định đầu tư gửi Owner",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "created_at",
    "asset",
    "action",
    "thesis",
    "evidence_refs",
    "bear_case",
    "downside",
    "confidence",
    "invalidation",
    "risk_assessment_ref",
    "owner_gate_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "asset": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "BUY",
        "ADD",
        "HOLD",
        "REDUCE",
        "SELL",
        "NO_ACTION",
        "WATCH"
      ]
    },
    "size": {
      "type": "string"
    },
    "time_horizon": {
      "type": "string"
    },
    "thesis": {
      "type": "string"
    },
    "hypothesis_ref": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bull_case": {
      "type": "string"
    },
    "base_case": {
      "type": "string"
    },
    "bear_case": {
      "type": "string"
    },
    "scenario_probabilities": {
      "type": "object",
      "properties": {
        "bull": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "base": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bear": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "expected_return": {
      "type": "string"
    },
    "downside": {
      "type": "string"
    },
    "confidence": {
      "type": "object",
      "required": [
        "value",
        "basis"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "regime_ref": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_assessment_ref": {
      "type": "string"
    },
    "deployment_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "owner_gate_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ]
    }
  },
  "additionalProperties": false
}
