{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trung-tam-tai-chinh/contracts/evidence_item.schema.json",
  "title": "EVIDENCE_ITEM",
  "description": "Một mảnh bằng chứng trong Evidence Graph",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "created_at",
    "claim_ref",
    "stance",
    "source",
    "observation",
    "quality"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "claim_ref": {
      "type": "string"
    },
    "stance": {
      "type": "string",
      "enum": [
        "supporting",
        "contrary",
        "neutral"
      ]
    },
    "source": {
      "type": "string"
    },
    "source_published_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation": {
      "type": "string"
    },
    "data_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_by": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
