{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trung-tam-tai-chinh/contracts/prediction.schema.json",
  "title": "PREDICTION",
  "description": "Dự báo kiểm chứng được — ghi TRƯỚC khi biết kết quả, bất biến",
  "type": "object",
  "required": [
    "created_at",
    "procedure",
    "claim",
    "question",
    "resolution_rule",
    "probability",
    "evidence_refs"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "procedure": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "resolution_rule": {
      "type": "object",
      "required": [
        "type",
        "ticker",
        "horizon"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "excess_return_positive"
          ]
        },
        "ticker": {
          "type": "string"
        },
        "horizon": {
          "type": "integer"
        },
        "benchmark": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        }
      }
    },
    "probability": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 0.95
    },
    "base_rate": {
      "type": "number"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "object"
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
