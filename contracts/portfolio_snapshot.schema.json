{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trung-tam-tai-chinh/contracts/portfolio_snapshot.schema.json",
  "title": "PORTFOLIO_SNAPSHOT",
  "description": "Ảnh chụp danh mục",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "created_at",
    "as_of",
    "mode",
    "positions"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "SIMULATION",
        "PAPER",
        "LIVE"
      ]
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset",
          "weight"
        ],
        "properties": {
          "asset": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "cost_basis": {
            "type": "number"
          }
        }
      }
    },
    "cash_weight": {
      "type": "number"
    },
    "exposures": {
      "type": "object"
    },
    "risk_budget_used": {
      "type": "number"
    }
  },
  "additionalProperties": false
}
