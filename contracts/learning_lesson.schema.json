{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trung-tam-tai-chinh/contracts/learning_lesson.schema.json",
  "title": "LEARNING_LESSON",
  "description": "Bài học rút ra",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "created_at",
    "lesson",
    "attribution_ref",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lesson": {
      "type": "string"
    },
    "attribution_ref": {
      "type": "string"
    },
    "valid_regimes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unverified_regimes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "object",
      "required": [
        "value",
        "basis"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "proposed_change": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "OBSERVATION",
        "UNVERIFIED",
        "WEAK",
        "SUPPORTED",
        "STRONG",
        "REGIME_SPECIFIC",
        "INVALIDATED"
      ]
    }
  },
  "additionalProperties": false
}
